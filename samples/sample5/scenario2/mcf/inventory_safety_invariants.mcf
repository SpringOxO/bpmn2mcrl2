% Data-bound Safety Invariant for Depot Inventory Check (Scenario 2)
% Use pbes2bool -s2 when checking this formula.
%
% When the depot sends an empty container, the carried inventory count must stay non-negative.
[true*] forall cnt: Int .
  [c_send_empty_ctn_to_transport___count___1_to_transport__empty_ctn_received(order_id(1), cnt)] val(cnt >= 0)
